{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElToolkitDeRWBU",
  "version": "0.1.4",
  "identifier": "com.rwbu.eltoolkitderwbu",
  "build": {
    "beforeDevCommand": "node scripts/setup-sidecars.cjs && npm run vite:dev",
    "beforeBuildCommand": "node scripts/setup-sidecars.cjs && npm run vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ElToolkit",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 320,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' asset: https://asset.localhost http://asset.localhost blob: https://v.animethemes.moe;"
    }
  },
  "bundle": {
    "publisher": "RWBU",
    "shortDescription": "All-in-one desktop audio, video, and media toolkit powered by yt-dlp and FFmpeg.",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "yt-dlp",
      "ffmpeg",
      "ffprobe",
      "qjs"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  }
}
